# Copy to backend/.env and fill in.
# Get your key at https://yce.makeupar.com/api-console/en/api-keys/

YOUCAM_API_KEY=

# Optional. Only needed if your console issues a key + secret pair and the
# plain Bearer-key auth mode fails. `npm run verify` tells you which mode works.
YOUCAM_API_SECRET=

# Base host for the YouCam server-to-server API.
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com

# Local proxy port. The extension defaults to this.
PORT=8787
